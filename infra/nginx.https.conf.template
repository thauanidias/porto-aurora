resolver 127.0.0.11 valid=10s ipv6=off;
upstream tgpm_backend {
  zone tgpm_backend 64k;
  server backend:8000 resolve;
}
upstream tgpm_frontend {
  zone tgpm_frontend 64k;
  server frontend:80 resolve;
}
map "$request_method:$uri" $tgpm_auth_key {
  default "";
  ~^POST:/api/v1/auth/(login|register|request-link|confirm)$ $binary_remote_addr;
}
limit_req_zone $tgpm_auth_key zone=tgpm_auth:10m rate=20r/m;
limit_req_zone $binary_remote_addr zone=tgpm_api:10m rate=300r/m;
server {
  listen 443 ssl;
  ssl_certificate /etc/nginx/tls/fullchain.pem;
  ssl_certificate_key /etc/nginx/tls/private-key.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:tgpm_tls:10m;
  ssl_session_timeout 1d;
  ssl_session_tickets off;
  server_name _;
  client_max_body_size 11m;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header X-Frame-Options DENY always;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
  limit_req_status 429;
  location /api/v1/auth/ {
    limit_req zone=tgpm_auth burst=30 nodelay;
    proxy_pass http://tgpm_backend;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
  location /api/ {
    proxy_read_timeout 420s;
    limit_req zone=tgpm_api burst=100 nodelay;
    proxy_pass http://tgpm_backend;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
  location = /health { proxy_pass http://tgpm_backend; }
  location = /readiness { proxy_pass http://tgpm_backend; }
  location /carreiras/vagas/ {
    proxy_pass http://tgpm_backend;
    proxy_set_header Host $host;
  }
  location / { proxy_pass http://tgpm_frontend; }
}

# The canonical origin is supplied explicitly, never inferred from an untrusted Host.
server {
  listen 80;
  server_name _;
  return 308 ${PUBLIC_HTTPS_ORIGIN}$request_uri;
}
