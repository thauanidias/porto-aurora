ENVIRONMENT=development
POSTGRES_DB=tgpm
POSTGRES_USER=tgpm
POSTGRES_PASSWORD=CHANGE_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://tgpm:CHANGE_DATABASE_PASSWORD@postgres:5432/tgpm
REDIS_URL=redis://redis:6379/0
JWT_SECRET=CHANGE_JWT_SECRET
ENCRYPTION_KEY=CHANGE_ENCRYPTION_KEY
PUBLIC_URL=http://localhost:8088
# Leave both empty for local mode; the domains overlay configures all three URLs.
RH_URL=
MANAGER_URL=
CORS_ORIGINS=http://localhost:8088,http://localhost:5173
HTTP_PORT=8088
RESUME_AI_ENABLED=false
RESUME_AI_URL=http://resume-ai:11434
RESUME_AI_MODEL=qwen2.5:3b
UPLOAD_DIR=/data/uploads
CLAMAV_ENABLED=true
CLAMAV_HOST=clamav
SMTP_ENABLED=false
TEST_EMAIL_ENABLED=false
EMAIL_VERIFICATION_REQUIRED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_AUTH_MODE=oauth2
SMTP_OAUTH_TENANT_ID=
SMTP_OAUTH_CLIENT_ID=
SMTP_OAUTH_CLIENT_SECRET=
LDAP_ENABLED=false
LDAP_URL=
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_FILTER=(sAMAccountName={username})
LDAP_GROUP_BASE=
LDAP_CA_CERT_FILE=
LDAP_UPN_SUFFIX=
LDAP_NETBIOS_DOMAIN=
LDAP_RH_ONLY=false
LDAP_RH_ACCESS_MODE=saved
LDAP_RH_STORE_PASSWORD=false
LDAP_RH_DEPARTMENTS=RH
LDAP_RH_EXCEPTION_IDS=
LDAP_RH_SESSION_MINUTES=30
LDAP_RH_ROLE=RECRUTADOR
GRAPH_ENABLED=false
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_USER_ID=
WEBHOOK_ALLOWED_HOSTS=

TRUSTED_PROXY_HOSTS=nginx
